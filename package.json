{
  "name": "tiny-people",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "audit": "npm audit --audit-level=moderate",
    "check:browser": "node scripts/check-browser.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:plants": "node scripts/check-plants.mjs",
    "check:residents": "node scripts/check-residents.mjs",
    "check:exploration": "node scripts/check-exploration.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
